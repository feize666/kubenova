KUBENOVA_UPDATE_EXECUTOR_SOCKET=/run/kubenova-update/executor.sock
KUBENOVA_UPDATE_EXECUTOR_TOKEN=replace-with-long-random-executor-token
KUBENOVA_UPDATE_COMPOSE_FILE=/opt/kubenova/deploy/docker/docker-compose.prod.yml
KUBENOVA_UPDATE_ENV_FILE=/etc/kubenova/docker.env
KUBENOVA_UPDATE_COMPOSE_SCRIPT=/opt/kubenova/scripts/compose-release.sh
KUBENOVA_UPDATE_STATE_DIR=/var/lib/kubenova/update-executor
KUBENOVA_UPDATE_MIGRATION_TEST_COMMAND=
KUBENOVA_UPDATE_OLD_VERSION_COMPATIBILITY_COMMAND=
