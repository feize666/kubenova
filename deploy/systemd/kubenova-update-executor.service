[Unit]
Description=KubeNova host update executor
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kubenova
EnvironmentFile=/etc/kubenova/update-executor.env
ExecStart=/usr/bin/node /opt/kubenova/current/scripts/update-executor.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/kubenova

[Install]
WantedBy=multi-user.target
